NODE_ENV=development
PORT=25565
APP_ORIGIN=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:25565

DATABASE_URL=mysql-url
DB_AUTO_SYNC=false

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters
FILE_URL_SECRET=replace-with-at-least-32-random-characters

# 기존 프로젝트 변수명을 그대로 사용합니다.
CHATGPT_API_KEY=chatgpt-api-key
OPENAI_TEXT_MODEL=gpt-5.6-terra
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
OPENAI_MODERATION_MODEL=omni-moderation-latest
STORY_PAGE_COUNT=6
GENERATION_CONCURRENCY=1

REFRESH_COOKIE_NAME=dotori_refresh
UPLOAD_MAX_MB=10
STORAGE_PATH=storage
FILE_URL_TTL_SECONDS=3600